# Copy to `.streamlit/secrets.toml` for local use, or paste the same keys into
# Streamlit Community Cloud (App -> Settings -> Secrets). Never commit the real
# secrets.toml — it is git-ignored.

# --- Database (required for any hosted deployment) ---
# Supabase: Connect -> ORMs/psycopg2, or Project Settings -> Database.
# Use the SESSION POOLER string (host aws-0-<region>.pooler.supabase.com,
# port 5432). The "Direct connection" one (db.<ref>.supabase.co) is IPv6-only
# and cannot be reached from Streamlit Community Cloud.
# Note the username is postgres.<project-ref>, not bare postgres.
# sslmode=require is added automatically if you leave it off.
#
# Without this the app falls back to a local SQLite file that is WIPED every
# time a hosted container restarts.
DATABASE_URL = "postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Seed admin password (optional) ---
# Only used to create the very first admin account on an empty database.
# After migrating real users this is moot, but set it anyway for a public repo.
ADMIN_PASSWORD = "change-this-to-something-private"
